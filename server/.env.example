# Bind only to loopback; nginx exposes /kuakua-ai-api/ over HTTPS.
KUAKUA_HOST=127.0.0.1
KUAKUA_PORT=8791
KUAKUA_DATABASE_PATH=/var/lib/kuakua-ai-api/kuakua.sqlite3
KUAKUA_PAYMENT_QR_PATH=/etc/kuakua-ai-api/company-payment-qr.png
KUAKUA_ALLOWED_ORIGINS=https://happykua.com,https://www.happykua.com
KUAKUA_COOKIE_SECURE=1
KUAKUA_SESSION_DAYS=30
KUAKUA_PASSWORD_ITERATIONS=310000
KUAKUA_LOG_LEVEL=INFO

# DeepSeek is called only by the server. Keep the real key in the protected
# EnvironmentFile; never expose it through Vite variables or browser code.
DEEPSEEK_API_KEY=replace-with-a-server-side-deepseek-key
KUAKUA_DEEPSEEK_BASE_URL=https://api.deepseek.com
KUAKUA_DEEPSEEK_MODEL=deepseek-v4-flash
KUAKUA_DEEPSEEK_TIMEOUT_SECONDS=60

# Use these two variables together for the first start only. Put the real
# password in /etc/kuakua-ai-api/env with mode 0600, never in Git.
KUAKUA_BOOTSTRAP_ADMIN_EMAIL=admin@example.com
KUAKUA_BOOTSTRAP_ADMIN_PASSWORD=replace-with-a-random-secret-of-at-least-20-characters
